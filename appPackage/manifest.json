{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "m365-github-agent contributors",
    "websiteUrl": "https://github.com/fenghaitao/m365-github-agent",
    "privacyUrl": "https://github.com/fenghaitao/m365-github-agent",
    "termsOfUseUrl": "https://github.com/fenghaitao/m365-github-agent"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "GitHub Agent${{APP_NAME_SUFFIX}}",
    "full": "GitHub Agent for Microsoft 365 Copilot"
  },
  "description": {
    "short": "Use live GitHub tools from Microsoft 365 Copilot.",
    "full": "A Microsoft 365 Copilot declarative agent connected to GitHub's hosted MCP server for live repository, issue, pull request, and other GitHub operations."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "composeExtensions": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "github.com",
    "api.githubcopilot.com",
    "token.botframework.com"
  ]
}
