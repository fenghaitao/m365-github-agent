# Non-secret development environment values.
# This file is intended to be committed.

TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Generated during provision
TEAMS_APP_ID=
MCP_DA_AUTH_ID_APIGITHUBC=

# Set this to the Client ID of your GitHub OAuth App.
MCP_DA_OAUTH_CLIENT_ID_APIGITHUBC=

# Put the client secret in env/.env.dev.user (ignored by git):
# SECRET_MCP_DA_OAUTH_CLIENT_SECRET_APIGITHUBC=<secret>
